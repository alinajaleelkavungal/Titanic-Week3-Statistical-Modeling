# =========================================
# Model Performance Metrics
# =========================================

TN <- confusion_matrix["No", "No"]
FP <- confusion_matrix["No", "Yes"]
FN <- confusion_matrix["Yes", "No"]
TP <- confusion_matrix["Yes", "Yes"]

# Accuracy
accuracy <- (TP + TN) / (TP + TN + FP + FN)

# Precision
precision <- TP / (TP + FP)

# Recall
recall <- TP / (TP + FN)

# F1-score
f1_score <- 2 * (precision * recall) / (precision + recall)

# Display metrics
accuracy
precision
recall
f1_score
